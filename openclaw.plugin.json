{
  "id": "dsh-native",
  "name": "DeepSeek Harness Native",
  "description": "Explicitly selected native DSH runtime with OpenClaw-owned tools.",
  "activation": {
    "onStartup": false,
    "onAgentHarnesses": ["dsh-native"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "stateDir": {
        "type": "string",
        "description": "Absolute directory for private DSH sessions; default ~/.openclaw/dsh-native."
      },
      "startupTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 3600000, "default": 60000 },
      "shutdownTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 3600000, "default": 15000 },
      "streamIdleTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 3600000, "default": 120000 },
      "toolAllowlist": {
        "type": "array", "uniqueItems": true, "maxItems": 64,
        "description": "Exact OpenClaw tool names to expose after host authorization and compatibility checks. Omit for legacy defaults.",
        "items": { "type": "string", "pattern": "^(?!dsh_prepare_task$|run_code$)[A-Za-z0-9_-]{1,64}$" }
      },
      "taskPreparation": {
        "type": "object",
        "additionalProperties": false,
        "description": "Opt-in adaptive chat/clarify/draft/execute preparation. Does not add host permissions.",
        "properties": {
          "agentIds": {
            "type": "array", "uniqueItems": true, "maxItems": 12, "default": [],
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" }
          },
          "executionTools": {
            "type": "array", "uniqueItems": true, "maxItems": 64,
            "description": "Legacy narrowing list. Prefer top-level toolAllowlist; explicit conflicting lists are rejected.",
            "items": { "type": "string", "pattern": "^(?!dsh_prepare_task$|run_code$)[A-Za-z0-9_-]{1,64}$" }
          },
          "skillAllowlist": {
            "type": "array", "uniqueItems": true, "maxItems": 12, "default": [],
            "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" }
          },
          "maxClarificationTurns": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 },
          "maxToolCalls": { "type": "integer", "minimum": 1, "maximum": 100, "default": 24 }
        }
      },
      "allowedBaseUrls": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" },
        "default": ["https://api.deepseek.com"],
        "description": "Exact prepared model endpoints the DSH adapter may use. HTTP is restricted to loopback."
      },
      "allowedCopilotBaseUrls": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" },
        "default": [
          "https://api.individual.githubcopilot.com",
          "https://api.business.githubcopilot.com",
          "https://api.enterprise.githubcopilot.com",
          "https://api.githubcopilot.com"
        ],
        "description": "Exact Copilot account endpoints; separately scoped from DeepSeek. Custom or Enterprise tenant endpoints require explicit configuration."
      }
    }
  }
}
