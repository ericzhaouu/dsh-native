{
  "id": "dsh-native",
  "name": "DeepSeek Harness Native",
  "description": "Explicitly selected native DSH runtime with OpenClaw-owned tools.",
  "activation": {
    "onStartup": false,
    "onAgentHarnesses": ["dsh-native"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "definitions": {
      "scopedToolNames": {
        "type": "array", "uniqueItems": true, "maxItems": 64,
        "items": { "type": "string", "pattern": "^(?!__proto__$|prototype$|constructor$|dsh_prepare_task$|run_code$)[A-Za-z0-9_-]{1,64}$" }
      },
      "scopeId": { "type": "string", "pattern": "^(?!__proto__$|prototype$|constructor$)[A-Za-z0-9_-]{1,128}$" },
      "bitablePolicy": {
        "type": "object", "additionalProperties": false,
        "required": ["source", "accountId", "groupId", "appToken", "tableId", "recordIds", "fields", "operations", "maxBatchSize"],
        "properties": {
          "source": {
            "type": "object", "additionalProperties": false, "required": ["kind", "pluginId"],
            "properties": { "kind": { "const": "plugin" }, "pluginId": { "$ref": "#/definitions/scopeId" } }
          },
          "accountId": { "$ref": "#/definitions/scopeId" },
          "groupId": { "$ref": "#/definitions/scopeId" },
          "appToken": { "$ref": "#/definitions/scopeId" },
          "tableId": { "$ref": "#/definitions/scopeId" },
          "recordIds": {
            "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
            "items": { "$ref": "#/definitions/scopeId" }
          },
          "fields": {
            "type": "object", "minProperties": 1, "maxProperties": 64,
            "propertyNames": {
              "minLength": 1, "maxLength": 128,
              "pattern": "^(?!__proto__$|prototype$|constructor$|[fF][lL][dD]|\\s)(?!.*[\\u0000-\\u001f\\u007f])(?!.*\\s$).+$"
            },
            "additionalProperties": { "enum": ["string", "number", "boolean"] }
          },
          "operations": {
            "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
            "items": { "enum": ["get_record", "update_record"] }
          },
          "maxBatchSize": { "const": 1 }
        }
      },
      "operationalBudget": {
        "type": "object", "additionalProperties": false,
        "required": ["maxModelRequests", "maxInputTokens", "maxOutputTokens", "maxToolCalls", "maxDurationMs"],
        "properties": {
          "maxModelRequests": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "maxInputTokens": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "maxToolCalls": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "maxDurationMs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
        }
      }
    },
    "properties": {
      "operationalBudget": {
        "$ref": "#/definitions/operationalBudget",
        "description": "Opt-in trusted per-attempt ceilings. Actual provider requests include retries/preparation/automatic compaction. Reserve contextWindow input before each request (not exact tokenization); known usage includes cache and reasoning. Output is clipped to the remaining aggregate allowance. Unknown usage retains durable reservations and fences replay. Duration stops admission and requests cancellation, not remote-quiescence proof. Explicit compaction/review are separately capped attempts. Omit for legacy behavior."
      },
      "operationalBudgetByAgent": {
        "type": "object", "maxProperties": 64,
        "propertyNames": { "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
        "additionalProperties": { "$ref": "#/definitions/operationalBudget" },
        "description": "Exact trusted Agent ceilings per attempt, intersected with operationalBudget and any trusted host attempt cap. Unlisted Agents inherit the global cap, or remain unlimited when it is absent."
      },
      "stateDir": {
        "type": "string",
        "description": "Absolute directory for private DSH sessions; default ~/.openclaw/dsh-native."
      },
      "startupTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 3600000, "default": 60000 },
      "shutdownTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 3600000, "default": 15000 },
      "streamIdleTimeoutMs": { "type": "integer", "minimum": 100, "maximum": 3600000, "default": 120000 },
      "maxConcurrentRuns": { "type": "integer", "minimum": 1, "maximum": 64, "default": 8,
        "description": "Maximum concurrent operations per runtime instance; excess work is rejected before session admission, not queued or replayed." },
      "toolAllowlist": {
        "type": "array", "uniqueItems": true, "maxItems": 64,
        "description": "Exact OpenClaw tool names to expose after host authorization and compatibility checks. Omit for legacy defaults.",
        "items": { "type": "string", "pattern": "^(?!dsh_prepare_task$|run_code$)[A-Za-z0-9_-]{1,64}$" }
      },
      "toolAllowlistByAgent": {
        "type": "object", "maxProperties": 64,
        "propertyNames": { "pattern": "^(?!constructor$|prototype$)[a-z][a-z0-9_-]{0,63}$" },
        "additionalProperties": { "$ref": "#/definitions/scopedToolNames" },
        "description": "Exact trusted Agent replacement of DSH candidates, not a host grant. Empty means no tools. Unmatched Agents retain legacy behavior. Changed target policy requires a new session/reset epoch."
      },
      "bitablePolicyByAgent": {
        "type": "object", "maxProperties": 64,
        "propertyNames": { "pattern": "^(?!constructor$|prototype$)[a-z][a-z0-9_-]{0,63}$" },
        "additionalProperties": { "$ref": "#/definitions/bitablePolicy" },
        "description": "Default-off resource gate. Requires matching toolAllowlistByAgent containing only selected record operations, and a verified host-only exact-instance source/account/group/foreground capability. Stock SDK adapter supplies none, so production callbacks remain denied. No batch/list/create/delete/admin/HTTP/exec."
      },
      "taskPreparation": {
        "type": "object",
        "additionalProperties": false,
        "description": "Opt-in adaptive chat/clarify/draft/execute preparation. Does not add host permissions.",
        "properties": {
          "agentIds": {
            "type": "array", "uniqueItems": true, "maxItems": 12, "default": [],
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" }
          },
          "executionTools": {
            "type": "array", "uniqueItems": true, "maxItems": 64,
            "description": "Legacy narrowing list. Prefer top-level toolAllowlist; explicit conflicting lists are rejected.",
            "items": { "type": "string", "pattern": "^(?!dsh_prepare_task$|run_code$)[A-Za-z0-9_-]{1,64}$" }
          },
          "skillAllowlist": {
            "type": "array", "uniqueItems": true, "maxItems": 12, "default": [],
            "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" }
          },
          "skillAllowlistByAgent": {
            "type": "object",
            "additionalProperties": {
              "type": "array", "uniqueItems": true, "maxItems": 12,
              "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$" }
            },
            "maxProperties": 12,
            "propertyNames": { "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
            "description": "Optional exact per-Agent Skill allowlist override. Keys must also be listed in taskPreparation.agentIds; runtime validation enforces that match. A listed Agent's array replaces skillAllowlist; omitted Agents inherit it."
          },
          "maxClarificationTurns": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 },
          "maxToolCalls": { "type": "integer", "minimum": 1, "maximum": 100, "default": 24 }
        }
      },
      "allowedBaseUrls": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" },
        "default": ["https://api.deepseek.com"],
        "description": "Exact prepared model endpoints the DSH adapter may use. HTTP is restricted to loopback."
      },
      "allowedCopilotBaseUrls": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" },
        "default": [
          "https://api.individual.githubcopilot.com",
          "https://api.business.githubcopilot.com",
          "https://api.enterprise.githubcopilot.com",
          "https://api.githubcopilot.com"
        ],
        "description": "Exact Copilot account endpoints; separately scoped from DeepSeek. Custom or Enterprise tenant endpoints require explicit configuration."
      }
    }
  }
}
